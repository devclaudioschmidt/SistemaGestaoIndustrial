rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isRegraIn(regrasPermitidas) {
      let perfil = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
      return perfil.regras.hasAny(regrasPermitidas);
    }

    function isCargoIn(cargosPermitidos) {
      let perfil = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
      return perfil.cargo in cargosPermitidos;
    }

    match /_config/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/_config/$(doc));
      allow update: if request.auth != null && isRegraIn(["modulo.usuarios", "modulo.configuracoes"]);
      allow delete: if false;
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isRegraIn(["modulo.usuarios"]));
      allow create: if request.auth != null && (request.auth.uid == uid || isRegraIn(["modulo.usuarios"]));
      allow update: if request.auth != null && (request.auth.uid == uid || isRegraIn(["modulo.usuarios"]));
      allow delete: if request.auth != null && isRegraIn(["modulo.usuarios"]);
    }

    match /pedidos/{pedidoId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    match /orcamentos/{orcamentoId} {
      allow read: if request.auth != null && isRegraIn(["modulo.orcamentos"])
        && (isCargoIn(["master", "gerente", "financeiro"]) || resource.data.vendedorId == request.auth.uid);
      allow create: if request.auth != null && isRegraIn(["modulo.orcamentos"])
        && request.resource.data.audit.criadoPor == request.auth.uid;
      allow update: if request.auth != null && isRegraIn(["modulo.orcamentos"])
        && request.resource.data.audit.alteradoPor == request.auth.uid;
      allow delete: if request.auth != null && isRegraIn(["modulo.orcamentos"]);
    }
  }
}
